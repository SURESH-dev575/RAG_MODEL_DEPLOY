def save_knowledge_to_db(query: str, answer: str):
    try:
        today_str = date.today().strftime("%B %d, %Y")
        memory_text = f"Learned Fact (Date: {today_str})\nUser Question: {query}\nVerified Answer: {answer}"
        
        chunks = splitter.create_documents([memory_text])
        vectorDB.add_documents(chunks)
        
        console.print("[dim green] [Self-Learning] Saved this new knowledge to the local database![/dim green]")
    except Exception as e:
        console.print(f"[dim red] Failed to save memory: {e}[/dim red]")

# =====================================================
#  CORE GENERATION LOGIC
# =====================================================
def answer_with_llm(query: str, context: str, chat_history: list, is_offline: bool = False) -> str:
    intent = classify_query(query)

    if intent == "summary":
        template = summary_prompt
    elif intent == "code":
        template = code_prompt
    elif is_offline:
        template = offline_prompt
    else:
        template = general_prompt

    today_str = date.today().strftime("%B %d, %Y")
    formatted_hist = format_history_for_prompt(chat_history)

    raw_answer = llm.invoke(template.format(
        context=context,
        question=query,
        today=today_str,
        history=formatted_hist
    )).strip()

    stop_phrases = ["\nUser:", "User:", "\nQuestion:", "\nAI:"]
    for phrase in stop_phrases:
        if phrase in raw_answer:
            raw_answer = raw_answer.split(phrase)[0].strip()

    return raw_answer

def online_rag(raw_query: str, chat_history: list) -> str:
    standalone_query = contextualize_user_query(raw_query, chat_history)
    msg = " Searching the web (Tavily)..." if (TAVILY_AVAILABLE and TAVILY_API_KEY) else " Searching the web (DuckDuckGo fallback)..."
    console.print(f"[dim]{msg}[/dim]")
    
    web_text = web_search(standalone_query)
    answer = answer_with_llm(standalone_query, web_text, chat_history, is_offline=False)
    final_answer = append_verified_urls(answer, web_text)
    
    # Save the live knowledge locally
    save_knowledge_to_db(standalone_query, final_answer)
    
    return final_answer

def offline_rag(raw_query: str, chat_history: list) -> str:
    standalone_query = contextualize_user_query(raw_query, chat_history)
    console.print("[dim] Searching document database...[/dim]")
    search_keywords = extract_search_keywords(standalone_query)
    docs = retriever.invoke(search_keywords)
    context = "\n\n".join(d.page_content for d in docs)
    return answer_with_llm(standalone_query, context, chat_history, is_offline=True)

def hybrid_rag(raw_query: str, chat_history: list) -> str:
    standalone_query = contextualize_user_query(raw_query, chat_history)
    answer = offline_rag(raw_query, chat_history) 
    
    if "information is missing" in answer.lower() or len(answer) < 20:
        console.print("[dim yellow] [!] Missing in database. Consulting live web...[/dim yellow]")
        web_text = web_search(standalone_query)
        ai_answer = answer_with_llm(standalone_query, web_text, chat_history, is_offline=False)
        final_answer = append_verified_urls(ai_answer, web_text)
        
        # Save the fallback knowledge locally so it isn't missing next time
        save_knowledge_to_db(standalone_query, final_answer)
        
        return final_answer
    return answer

