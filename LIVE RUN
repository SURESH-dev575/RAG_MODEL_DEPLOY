rewrite_prompt = PromptTemplate.from_template(
    "Given the following conversation history and a new user question, "
    "rephrase the new question to be a standalone question that contains all necessary context. "
    "Do NOT answer the question, just reformulate it.\n"
    "If the new question is already clear, output it exactly as it is.\n\n"
    "Chat History:\n{history}\n\n"
    "New Question: {question}\n\n"
    "Standalone Question:"
)

def contextualize_user_query(query: str, chat_history: list) -> str:
    if not chat_history:
        return query
        
    console.print("[dim] [*] Analyzing conversation context...[/dim]")
    formatted_hist = format_history_for_prompt(chat_history)
    
    standalone_query = llm.invoke(
        rewrite_prompt.format(history=formatted_hist, question=query)
    ).strip().strip('"').strip("'")
    
    if "\n" in standalone_query:
        standalone_query = standalone_query.split("\n")[0].strip()
        
    if not standalone_query:
        return query
        
    console.print(f"[dim] [Memory] Rewrote Question To: '{standalone_query}'[/dim]")
    return standalone_query

