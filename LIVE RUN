def handle_image_request(query: str, chat_history: list) -> str:
    standalone = contextualize_user_query(query, chat_history)
    subject = extract_search_keywords(standalone)
    console.print(f"[dim] [*] Opening Google Images for: '{subject}'...[/dim]")

    encoded = subject.replace(" ", "+")
    search_url = f"https://www.google.com/search?tbm=isch&q={encoded}"

    try:
        webbrowser.open(search_url)
        return f" Opened Google Images for '{subject}' directly in your web browser.\nLink: {search_url}"
    except Exception as e:
        return f"Failed to open browser: {e}\nHere is the link: {search_url}"

